# GitHub personal access token with repo read scope (public_repo is sufficient for public repos).
# Used by src/collection/github_collector.py for issues, PRs, reviews, and releases.
GITHUB_TOKEN=

# Optional: only needed once the Neo4j knowledge graph stage (Stage 8) begins.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional: powers the diff-explanation feature (src/llm/groq_client.py,
# CLAUDE.md Section 9 -- explanation only, never used to compute or
# validate HistSig's own P/R scores). Free tier: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: overrides the default model (openai/gpt-oss-120b). Groq's
# free-tier model lineup changes over time -- check
# https://api.groq.com/openai/v1/models (with your key) for what's
# currently available if the default ever starts 404ing.
GROQ_MODEL=
